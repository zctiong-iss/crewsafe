{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "components"],
  "properties": {
    "schema_version": { "const": 1 },
    "components": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["jira_key", "root", "backend_strategy", "state_key", "allow_destroy"],
        "properties": {
          "jira_key": { "type": "string", "pattern": "^SCRUM-[0-9]+$" },
          "root": { "type": "string", "pattern": "^infra/terraform/[a-z0-9][a-z0-9/_-]*$" },
          "backend_strategy": { "enum": ["self-bootstrap", "remote"] },
          "state_key": { "type": "string", "pattern": "^crewsafe/[a-z0-9][a-z0-9/_.-]*\\.tfstate$" },
          "allow_destroy": { "type": "boolean" }
        }
      }
    }
  }
}
