# Copy to `.env` and fill in. Expo inlines EXPO_PUBLIC_* at bundle time, so nothing here is
# secret — a client id and a pool id travel in every authorize request anyway. They live here
# because they differ per machine and per environment, not because they are sensitive.
#
# Never put a password, an AWS credential, or a client secret in this file. The mobile app
# has no client secret by design: every Cognito app client it uses is a public client.

# ---------------------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------------------
# Expo Go on a PHYSICAL DEVICE cannot reach your machine's `localhost` — the phone resolves
# that to itself. Use whichever line matches how you are running:
#
#   physical device   http://192.168.x.x:8080   <- your machine's LAN IP (`ipconfig`)
#   Android emulator  http://10.0.2.2:8080      <- the emulator's alias for the host
#   iOS simulator     http://localhost:8080     <- shares the host network
#   Expo web          http://localhost:8080
#
# The device and your machine must be on the same Wi-Fi network.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:8080

# ---------------------------------------------------------------------------------------
# Auth mode
# ---------------------------------------------------------------------------------------
# mock              No network. Signs in as a seeded demo user. Works everywhere. Default.
# cognito-password  REAL Cognito tokens inside Expo Go, via the crewsafe-cli-integration
#                   client's USER_PASSWORD_AUTH flow. Needs no redirect URI, so it is the
#                   only real-token path that works on a phone without a native build.
#                   Requires run.sh to allow cli_client_id (it does, as of this change) and
#                   the synthetic users' passwords from AWS Secrets Manager.
# cognito-pkce      The production-shaped Hosted UI + PKCE flow. On a phone this needs a
#                   dev build, because the mobile client's callback is pinned to
#                   crewsafe://callback and Expo Go cannot register that scheme. It DOES
#                   work today under `npx expo start --web --port 5173`, which reuses the
#                   web client's already-registered callback and CORS origin.
#
# Every mode is rejected outside __DEV__ except cognito-pkce. See src/auth/authMode.ts.
EXPO_PUBLIC_AUTH_MODE=mock

# ---------------------------------------------------------------------------------------
# Cognito — required only when AUTH_MODE is cognito-password or cognito-pkce
# ---------------------------------------------------------------------------------------
# Read these off the same shared config `run.sh` uses:
#   gh variable get CREWSAFE_SHARED_COGNITO_JSON --json value --jq .value \
#     | jq '.accounts.dev | {region, issuer_uri, hosted_ui_url, web_client_id, cli_client_id}'
EXPO_PUBLIC_COGNITO_REGION=ap-southeast-1
EXPO_PUBLIC_COGNITO_ISSUER_URI=https://cognito-idp.ap-southeast-1.amazonaws.com/ap-southeast-1_XXXXXXXXX
EXPO_PUBLIC_COGNITO_HOSTED_UI_DOMAIN=https://xxxxxxxxxxxx.auth.ap-southeast-1.amazoncognito.com

# cognito-password uses this one (ALLOW_USER_PASSWORD_AUTH, no redirect needed).
EXPO_PUBLIC_COGNITO_CLI_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# cognito-pkce on Expo web uses the WEB client, because http://localhost:5173/callback is
# already registered against it. A native dev build would use the MOBILE client instead.
EXPO_PUBLIC_COGNITO_WEB_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_COGNITO_MOBILE_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
