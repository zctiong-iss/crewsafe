  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "//overrides": [
    "react-native-actions-sheet@10 declares `react-native-worklets: ^0.7.1` as a direct",
    "dependency, while Expo SDK 57's react-native-reanimated needs 0.10.x. A caret on a 0.x",
    "version does not span minors, so npm installs a SECOND nested copy. Two copies of a",
    "native module is a build error waiting to happen in any native build, and non-obvious",
    "when it fires. Pinning it to the root version is the standard fix; `$name` resolves to",
    "whatever this package.json declares, so it cannot drift out of step on an upgrade."
  ],
  "overrides": {
    "react-native-actions-sheet": {
      "react-native-worklets": "$react-native-worklets"
    }
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "//web:pkce": "Port 5173 is not cosmetic — it is the callback already registered on the Cognito web client, so AUTH_MODE=cognito-pkce works here with no infrastructure change.",
    "web:pkce": "expo start --web --port 5173",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor"
  },
  "private": true
}
