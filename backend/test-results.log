Expecting actual:
  "spring:
  application:
    name: crewsafe-backend

  datasource:
    # Local default points at the container in local/compose.yaml (host port 5434).
    # Staging and production inject these from AWS Secrets Manager.
    url: ${DB_URL:jdbc:postgresql://localhost:5434/crewsafe}
    username: ${DB_USERNAME:crewsafe}
    password: ${DB_PASSWORD:crewsafe_local_dev}

  jpa:
    # Flyway owns the schema. Hibernate must never alter it — 'validate' makes a drift
    # between entities and migrations fail fast at startup instead of silently at runtime.
    hibernate:
      ddl-auto: validate
    open-in-view: false
    properties:
      hibernate:
        jdbc:
          time_zone: UTC

  flyway:
    enabled: true
    locations: classpath:db/migration
    baseline-on-migrate: false

server:
  port: ${SERVER_PORT:8080}

app:
  cors:
    # Vite dev server and the Expo web preview. Staging and production override this.
    allowed-origins: ${CORS_ALLOWED_ORIGINS:http://localhost:5173,http://localhost:8081}

  nea:
    # Root of data.gov.sg's real-time weather APIs. Keeping this configurable lets tests
    # use a local HTTP stub without giving fixture mode (SCRUM-167) a production code path.
    base-url: ${NEA_API_BASE_URL:https://api-open.data.gov.sg/v2/real-time/api}
    # Optional for local development. Production deployments should request a data.gov.sg
    # key for higher rate limits and inject it as a secret.
    api-key: ${NEA_API_KEY:}
    connect-timeout: ${NEA_CONNECT_TIMEOUT:5s}
    read-timeout: ${NEA_READ_TIMEOUT:10s}
    # Retry only temporary transport, rate-limit, and server failures. Backoff is bounded so
    # one scheduled poll cannot wait indefinitely when data.gov.sg is unavailable.
    max-attempts: ${NEA_MAX_ATTEMPTS:3}
    initial-backoff: ${NEA_INITIAL_BACKOFF:250ms}
    max-backoff: ${NEA_MAX_BACKOFF:2s}

  weather:
    data:
      # "live" uses data.gov.sg; "fixture" replays the bundled, clearly simulated demo
      # scenario without any network dependency.
      mode: ${WEATHER_DATA_MODE:live}
    fixture:
      resource: ${WEATHER_FIXTURE_RESOURCE:classpath:weather/fixtures/nea-demo-replay.json}
      # false advances to the final frame and then holds it; true loops to the beginning.
      loop: ${WEATHER_FIXTURE_LOOP:false}
    ingestion:
      # Opt in per environment. This prevents developer/test startup from silently calling
      # an external safety-data service; live deployments enable it explicitly.
      enabled: ${WEATHER_INGESTION_ENABLED:false}
      initial-delay: ${WEATHER_INGESTION_INITIAL_DELAY:5s}
      interval: ${WEATHER_INGESTION_INTERVAL:15m}
      delayed-after: ${WEATHER_DELAYED_AFTER:20m}
      stale-after: ${WEATHER_STALE_AFTER:45m}

  lightning:
    # Shares WEATHER_DATA_MODE: "live" hits the confirmed GET /weather?api=lightning
    # endpoint, "fixture" replays the bundled scenario. One toggle for whether this
    # instance calls real government APIs at all, matching app.weather.data.mode.
    fixture:
      resource: ${LIGHTNING_FIXTURE_RESOURCE:classpath:lightning/fixtures/nea-demo-replay.json}
      loop: ${LIGHTNING_FIXTURE_LOOP:false}
    ingestion:
      # Opt in per environment, same reasoning as app.weather.ingestion.enabled.
      enabled: ${LIGHTNING_INGESTION_ENABLED:false}
      initial-delay: ${LIGHTNING_INGESTION_INITIAL_DELAY:5s}
      # NEA refreshes lightning roughly every two minutes; a stop-work decision can't wait
      # on WBGT's fifteen-minute cadence.
      interval: ${LIGHTNING_INGESTION_INTERVAL:2m}
      delayed-after: ${LIGHTNING_DELAYED_AFTER:5m}
      stale-after: ${LIGHTNING_STALE_AFTER:15m}
    risk:
      # Neither figure is specified by SCRUM-170, its Jira parent, or the project plan
      # (which only says "hold until a supervisor-confirmed all-clear, typically 30
      # minutes"). Defaults: the common "30-30 rule" radii and that 30-minute figure as an
      # auto-expiring window. See LightningRiskProperties.
      stop-work-radius-km: ${LIGHTNING_STOP_WORK_RADIUS_KM:10}
      advisory-radius-km: ${LIGHTNING_ADVISORY_RADIUS_KM:20}
      validity-window: ${LIGHTNING_VALIDITY_WINDOW:30m}

  conditions:
    stream:
      # How often a subscribed dashboard tab receives a fresh conditions/shift snapshot.
      push-interval: ${CONDITIONS_STREAM_PUSH_INTERVAL:15s}
      # How long an idle SSE connection is held open before the client must reconnect.
      emitter-timeout: ${CONDITIONS_STREAM_EMITTER_TIMEOUT:5m}

  # app.cognito.* is deliberately absent from this file. Every value is required (see the
  # @NotBlank/@NotEmpty constraints on CognitoProperties), so leaving them undefined here
  # means a deployment that forgets one fails at startup with a validation error naming the
  # missing property — instead of quietly falling back to a developer machine's settings.
  #
  # Do NOT reintroduce these as `${COGNITO_ISSUER_URI}` placeholders without a default: an
  # unresolved placeholder binds as the literal string "${COGNITO_ISSUER_URI}", which
  # satisfies @NotBlank and starts the application with nonsense configuration.
  #
  # Local development:      run.sh/run-docker.sh supply validated shared Cognito values
  # Staging and production: set these environment variables, which Spring binds by relaxed
  #                         naming with no entry needed here —
  #                           APP_COGNITO_ISSUER_URI
  #                           APP_COGNITO_JWK_SET_URI
  #                           APP_COGNITO_CLIENT_IDS      (comma-separated)
  #                           APP_COGNITO_DEMO_USERS_JSON
  #
  # issuer-uri and jwk-set-uri remain separate so issuer validation stays exact while the
  # pinned test-only emulator can expose JWKS on a random Testcontainers port. Against
  # deployed Cognito the two naturally coincide.

  bedrock:
    # Amazon Bedrock configuration for AI-driven mitigation generation (SCRUM-187 spike)
    # Calls FastAPI endpoint which invokes Bedrock runtime
    region: ${AWS_REGION:ap-southeast-1}
    bedrock-api-url: ${BEDROCK_API_URL:http://localhost:8000}
    bedrock-timeout-ms: ${BEDROCK_TIMEOUT_MS:5000}
    # Claude 3.5 Sonnet model ID for structured output support
    model-id: ${BEDROCK_MODEL_ID:anthropic.claude-3-5-sonnet-20241022-v2:0}
    max-tokens: ${BEDROCK_MAX_TOKENS:1024}
    temperature: ${BEDROCK_TEMPERATURE:0.7}

# Expose only what we need. Health is used by the container platform and the
# smoke tests; everything else stays closed by default.
management:
  endpoints:
    web:
      exposure:
        include: health,info
  endpoint:
    health:
      show-details: never
      show-components: never
      probes:
        enabled: true
      group:
        liveness:
          include: livenessState
        readiness:
          include: readinessState,db,nea

logging:
  level:
    com.crewsafe: DEBUG
  structured:
    format:
      console: ecs
    ecs:
      service:
        name: ${spring.application.name}
        environment: ${SPRING_PROFILES_ACTIVE:local}
"
