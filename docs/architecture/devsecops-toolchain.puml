title CrewSafe SG — Manual Operational Workflows

top to bottom direction
skinparam dpi 160
skinparam defaultFontName Arial
skinparam defaultFontSize 17
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam wrapWidth 180
skinparam maxMessageSize 150
skinparam nodesep 45
skinparam ranksep 55
skinparam ArrowColor #455A64

skinparam rectangle {
  BackgroundColor #ECEFF1
  BorderColor #455A64
  FontColor #263238
  FontSize 17
}
skinparam artifact {
  BackgroundColor #F3E5F5
  BorderColor #7B1FA2
  FontColor #4A148C
  FontSize 17
}

actor "Developer / operator" as operator

package "Web recovery / sync\nmanual · main-ref gated" as web_recovery {
  rectangle "Build exact main SHA\nweb audit · lint · type · test" as web_sync_build
  rectangle "Sync S3 bundle\nverify edge + invalidate CloudFront" as web_sync
}

package "ML sidecar redeploy\nmanual · main-ref gated" as ml_recovery {
  rectangle "Resolve existing image\nmain-ancestor SHA → digest" as ml_resolve
  rectangle "Update shared ECS service\nml-service container only" as ml_redeploy
}

package "Mobile security testing\nmanual · main-ref gated" as mobile_security {
  rectangle "Native build\nAndroid/iOS artifact" as mobile_build
  rectangle "MobSF dynamic scan\nMaestro-driven sign-in flow" as mobsf_scan
}

package "Cognito operations\nmanual · main-ref gated" as cognito_ops {
  rectangle "Mapping publication\nstaging app config" as cognito_mapping
  rectangle "User administration\nallowlisted operations" as cognito_admin
}

operator --> web_sync_build
web_sync_build --> web_sync
operator --> ml_resolve
ml_resolve --> ml_redeploy
operator --> mobile_build
mobile_build --> mobsf_scan
operator --> cognito_mapping
operator --> cognito_admin

note right of mobile_build
  workflow_dispatch only.
  Never runs on push or pull_request.
  auth_mode=cognito-password builds a
  staging-authenticated artifact for MobSF.
  Never produces a store-ready artifact.
end note

note right of web_sync
  Exact commit is supplied at dispatch.
  OIDC web-sync role only; stale S3
  objects are deleted and the web
  distribution is invalidated.
end note

note right of ml_redeploy
  Existing immutable image only.
  Dedicated ml-service deploy role.
  Shared backend ECS service is updated;
  backend image is left untouched.
end note

note right of mobsf_scan
  Findings recorded as CI evidence.
  Non-blocking this iteration.
end note

note right of cognito_admin
  Allowlisted operations only
  (inspect, group membership, synthetic
  worker lifecycle, forced sign-out, ...).
  Every state change requires a typed
  "<operation> <alias> <subject>" phrase.
end note

legend right
  |= Style |= Meaning |
  --> | Manual trigger or hand-off |
  |<#ECEFF1>| Manual, main-only workflow |
  |<#F3E5F5>| Security evidence |
endlegend

@enduml
