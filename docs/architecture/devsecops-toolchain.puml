@startuml devsecops-toolchain

' Standalone DevSecOps view. Labels are intentionally short so the diagram stays
' readable when rendered at document size; workflow names and exact commands are
' recorded in the repository's .github/workflows files.

title CrewSafe SG — DevSecOps Toolchain

left to right direction
skinparam dpi 160
skinparam defaultFontName Arial
skinparam defaultFontSize 17
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam wrapWidth 155
skinparam maxMessageSize 130
skinparam nodesep 45
skinparam ranksep 75
skinparam ArrowColor #455A64

skinparam rectangle {
  BackgroundColor #E8F5E9
  BorderColor #2E7D32
  FontColor #1B5E20
  FontSize 17
}
skinparam cloud {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
  FontColor #0D47A1
  FontSize 17
}
skinparam database {
  BackgroundColor #FFF3E0
  BorderColor #EF6C00
  FontColor #E65100
  FontSize 17
}
skinparam artifact {
  BackgroundColor #F3E5F5
  BorderColor #7B1FA2
  FontColor #4A148C
  FontSize 17
}

actor "Developer" as developer
artifact "GitHub Actions\nPR · push · schedule · dispatch" as actions

package "Build and test" as build {
  artifact "Backend CI\nJava 21 · Maven verify" as backend_ci
  artifact "Web CI\nNode 22 · lint · test · build" as web_ci
  artifact "Mobile CI\nNode 22 · locale · test" as mobile_ci
  artifact "ml-service CI\nPython · pytest · Trivy" as mlservice_ci
}

package "Security gates" as security_gates {
  artifact "Secret scan\ngitleaks · fail closed" as secret_scan
  artifact "SAST / SCA\nSonarCloud + coverage" as sast
  artifact "Image scan\nTrivy HIGH / CRITICAL" as image_scan
  artifact "IaC scan\nTerraform · Trivy" as iac_scan
  artifact "Gate self-tests" as gate_tests
}

package "Reviewed artifacts" as artifacts {
  database "ECR\nbackend + web + ml-service\nimmutable + Inspector" as ecr_release
  database "S3\nversioned web bundle" as s3_release
  artifact "Plan bundle\nmetadata + lockfile" as tf_plan
  database "Remote state\nS3 · per-component keys" as tf_state
}

package "Controlled delivery" as delivery {
  cloud "ECS staging\nbackend + ml-service sidecar" as ecs_release
  cloud "ECS sidecar redeploy\nworkflow_dispatch\nexisting main SHA" as mlservice_redeploy
  cloud "CloudFront + S3\nweb staging" as web_release
  cloud "Terraform Apply\nmain + confirmation" as tf_apply
  cloud "Security Hub\nredacted import" as sh_import
}

package "Staging verification" as verification {
  artifact "Staging smoke\nauth + WBGT check" as smoke_staging
  artifact "Authenticated DAST\nOWASP ZAP baseline" as dast_staging
}

package "OIDC roles" as roles {
  artifact "ECR push\nbackend" as role_ecr
  artifact "ECR push\nml-service" as role_ecr_mlservice
  artifact "Web sync\nS3 + invalidation" as role_web
  artifact "Backend deploy\nECS service" as role_backend
  artifact "ml-service deploy\nECS service · manual" as role_mlservice_deploy
  artifact "Terraform plan / apply\nstate + component" as role_tf
  artifact "Security Hub import\nBatchImport only" as role_sh
}

developer --> actions
actions --> backend_ci
actions --> web_ci
actions --> mobile_ci
actions --> mlservice_ci
actions --> secret_scan
actions --> sast
actions --> image_scan
actions --> iac_scan
actions --> gate_tests

backend_ci --> image_scan
mlservice_ci --> image_scan
image_scan --> ecr_release
ecr_release --> ecs_release
web_ci --> s3_release
s3_release --> web_release
iac_scan --> tf_plan
tf_plan --> tf_apply
tf_apply --> tf_state
sast --> sh_import

actions --> role_ecr
actions --> role_ecr_mlservice
actions --> role_web
actions --> role_backend
actions --> role_mlservice_deploy
actions --> role_tf
actions --> role_sh
role_ecr --> ecr_release
role_ecr_mlservice --> ecr_release
role_web --> s3_release
role_backend --> ecs_release
role_mlservice_deploy --> mlservice_redeploy
mlservice_redeploy --> ecs_release
role_tf --> tf_apply
role_sh --> sh_import

note right of ecr_release
  Backend publish or an explicit
  main-ancestor sidecar redeploy
  consumes these immutable images;
  ml-service publication alone does
  not roll the sidecar automatically.
end note

ecs_release --> smoke_staging
web_release --> smoke_staging
ecs_release --> dast_staging
web_release --> dast_staging

note right of actions
  PR: build, test and scan.
  Main: publish and promote.
  Daily: full secret sweep.
end note

note right of tf_apply
  CI-only mutation.
  Requires reviewed plan,
  exact commit and confirmation.
end note

note bottom of sast
  Covers backend, web, mobile and ml-service.
  Coverage is generated first.
  Package lifecycle scripts are disabled;
  downloaded tools use HTTPS + checksums.
end note

note bottom of roles
  OIDC is short-lived and role-scoped.
  No long-lived cloud keys in CI.
  ml-service publication and deployment
  use separate roles and gates.
end note

note bottom of verification
  Runs after a successful staging deploy
  (backend and web release workflows).
  Evidence only: does not roll back
  or block the release already made.
end note

legend right
  |= Color |= Meaning |
  |<#F3E5F5>| Build, test, security and identity |
  |<#FFF3E0>| Reviewed artifacts and state |
  |<#E3F2FD>| Controlled AWS delivery |
  --> | Promotion, identity or evidence flow |
endlegend

