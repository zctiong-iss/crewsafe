@startuml devsecops-toolchain

' Standalone DevSecOps view. Labels are intentionally short so the diagram stays
' readable when rendered at document size; workflow names and exact commands are
' recorded in the repository's .github/workflows files.

title CrewSafe SG — DevSecOps Toolchain

left to right direction
skinparam dpi 160
skinparam defaultFontName Arial
skinparam defaultFontSize 17
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam wrapWidth 155
skinparam maxMessageSize 130
skinparam nodesep 45
skinparam ranksep 75
skinparam ArrowColor #455A64

skinparam rectangle {
  BackgroundColor #E8F5E9
  BorderColor #2E7D32
  FontColor #1B5E20
  FontSize 17
}
skinparam cloud {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
  FontColor #0D47A1
  FontSize 17
}
skinparam database {
  BackgroundColor #FFF3E0
  BorderColor #EF6C00
  FontColor #E65100
  FontSize 17
}
skinparam artifact {
  BackgroundColor #F3E5F5
  BorderColor #7B1FA2
  FontColor #4A148C
  FontSize 17
}

actor "Developer" as developer
artifact "GitHub Actions\nPR · push · schedule · dispatch" as actions

package "Build and test" as build {
  artifact "Backend CI\nJava 21 · Maven verify" as backend_ci
  artifact "Web CI\nNode 22 · lint · test · build" as web_ci
  artifact "Mobile CI\nNode 22 · locale · test" as mobile_ci
  artifact "ml-service CI\nPython · pytest" as mlservice_ci
}

package "Security gates" as security_gates {
  artifact "Secret scan\ngitleaks · fail closed" as secret_scan
  artifact "SAST / SCA\nSonarCloud + coverage" as sast
  artifact "Image scan\nTrivy HIGH / CRITICAL" as image_scan
  artifact "IaC scan\nTerraform · Trivy" as iac_scan
  artifact "Gate self-tests" as gate_tests
}

package "Reviewed artifacts" as artifacts {
  database "ECR\nbackend + web + ml-service\nimmutable + scan" as ecr_release
  database "S3\nversioned web bundle" as s3_release
  artifact "Plan bundle\nmetadata + lockfile" as tf_plan
  database "Remote state\nS3 · per-component keys" as tf_state
}

package "Controlled delivery" as delivery {
  cloud "ECS staging\nbackend + ml-service sidecar" as ecs_release
  cloud "CloudFront + S3\nweb staging" as web_release
  cloud "Terraform Apply\nmain + confirmation" as tf_apply
  cloud "Security Hub\nredacted import" as sh_import
}

package "OIDC roles" as roles {
  artifact "ECR push\nbackend" as role_ecr
  artifact "ECR push\nml-service" as role_ecr_mlservice
  artifact "Web sync\nS3 + invalidation" as role_web
  artifact "Backend deploy\nECS service" as role_backend
  artifact "Terraform plan / apply\nstate + component" as role_tf
  artifact "Security Hub import\nBatchImport only" as role_sh
}

developer --> actions
actions --> backend_ci
actions --> web_ci
actions --> mobile_ci
actions --> mlservice_ci
actions --> secret_scan
actions --> sast
actions --> image_scan
actions --> iac_scan
actions --> gate_tests

backend_ci --> image_scan
mlservice_ci --> image_scan
image_scan --> ecr_release
ecr_release --> ecs_release
web_ci --> s3_release
s3_release --> web_release
iac_scan --> tf_plan
tf_plan --> tf_apply
tf_apply --> tf_state
sast --> sh_import

actions --> role_ecr
actions --> role_ecr_mlservice
actions --> role_web
actions --> role_backend
actions --> role_tf
actions --> role_sh
role_ecr --> ecr_release
role_ecr_mlservice --> ecr_release
role_web --> s3_release
role_backend --> ecs_release
role_tf --> tf_apply
role_sh --> sh_import

note right of actions
  PR: build, test and scan.
  Main: publish and promote.
  Daily: full secret sweep.
end note

note right of tf_apply
  CI-only mutation.
  Requires reviewed plan,
  exact commit and confirmation.
end note

note bottom of sast
  Covers backend, web and mobile.
  Coverage is generated first.
end note

note bottom of roles
  OIDC is short-lived and role-scoped.
  No long-lived cloud keys in CI.
end note

legend right
  |= Color |= Meaning |
  |<#F3E5F5>| Build, test, security and identity |
  |<#FFF3E0>| Reviewed artifacts and state |
  |<#E3F2FD>| Controlled AWS delivery |
  --> | Promotion, identity or evidence flow |
endlegend

newpage

title CrewSafe SG — DevSecOps Control Detail

top to bottom direction
skinparam dpi 160
skinparam defaultFontName Arial
skinparam defaultFontSize 17
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam wrapWidth 180
skinparam maxMessageSize 150
skinparam nodesep 45
skinparam ranksep 55
skinparam ArrowColor #455A64

skinparam rectangle {
  BackgroundColor #ECEFF1
  BorderColor #455A64
  FontColor #263238
  FontSize 17
}
skinparam artifact {
  BackgroundColor #F3E5F5
  BorderColor #7B1FA2
  FontColor #4A148C
  FontSize 17
}
skinparam database {
  BackgroundColor #FFF3E0
  BorderColor #EF6C00
  FontColor #E65100
  FontSize 17
}

package "Pull request gates" as pr_gates {
  rectangle "Backend\nMaven verify" as pr_backend
  rectangle "Web\nlint · type · test · build" as pr_web
  rectangle "Mobile\nlint · type · locale · test" as pr_mobile
  rectangle "ml-service\npytest · Trivy" as pr_mlservice
  artifact "Secrets\ngitleaks" as pr_secrets
  artifact "SAST / SCA\nSonar Quality Gate" as pr_sast
  artifact "Terraform\nfmt · validate · test" as pr_tf
}

package "Main-branch promotion" as main_promotion {
  rectangle "Build immutable image\ncommit SHA + digest" as main_image
  rectangle "Build ml-service image\ncommit SHA + digest" as main_mlservice_image
  rectangle "Sync static web\nS3 + CloudFront invalidate" as main_web
  rectangle "Deploy backend\nECS service update\n(carries ml-service sidecar)" as main_backend
  rectangle "Apply infrastructure\nreviewed plan + confirmation" as main_tf
}

package "Evidence and response" as evidence {
  artifact "Job summaries\nstatus · commit · digest" as summaries
  artifact "Plan bundle\nmetadata · lockfile · run ID" as plan_evidence
  artifact "Security summary\nfindings · gate state" as security_evidence
  database "CloudWatch\napplication + database logs" as cw
  database "Security Hub\nInspector + Sonar findings" as sh
}

pr_backend --> main_image
pr_mlservice --> main_mlservice_image
pr_web --> main_web
pr_backend --> main_backend
main_mlservice_image --> main_backend
pr_tf --> main_tf
pr_secrets --> security_evidence
pr_sast --> security_evidence
pr_tf --> plan_evidence
main_image --> summaries
main_mlservice_image --> summaries
main_web --> summaries
main_backend --> summaries
main_tf --> plan_evidence
main_backend --> cw
main_tf --> summaries
security_evidence --> sh

note right of pr_tf
  Terraform is never run from a workstation.
  Validation is separate from plan and apply.
end note

note right of main_tf
  Apply checks account, commit, component,
  plan metadata and typed confirmation.
end note

note bottom of security_evidence
  Import to Security Hub is main-only,
  controlled, redacted and non-remediating.
end note

legend right
  |= Style |= Meaning |
  --> | Gate, promotion or evidence flow |
  |<#ECEFF1>| CI stage |
  |<#F3E5F5>| Security / evidence |
  |<#FFF3E0>| Artifact / observability |
endlegend

@enduml
