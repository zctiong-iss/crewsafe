title CrewSafe SG — DevSecOps Control Detail

top to bottom direction
skinparam dpi 160
skinparam defaultFontName Arial
skinparam defaultFontSize 17
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam wrapWidth 180
skinparam maxMessageSize 150
skinparam nodesep 45
skinparam ranksep 55
skinparam ArrowColor #455A64

skinparam rectangle {
  BackgroundColor #ECEFF1
  BorderColor #455A64
  FontColor #263238
  FontSize 17
}
skinparam artifact {
  BackgroundColor #F3E5F5
  BorderColor #7B1FA2
  FontColor #4A148C
  FontSize 17
}
skinparam database {
  BackgroundColor #FFF3E0
  BorderColor #EF6C00
  FontColor #E65100
  FontSize 17
}

package "Pull request gates" as pr_gates {
  rectangle "Backend\nMaven verify" as pr_backend
  rectangle "Web\nlint · type · test · build" as pr_web
  rectangle "Mobile\nlint · type · locale · test" as pr_mobile
  rectangle "ml-service\npytest · Trivy" as pr_mlservice
  artifact "Secrets\ngitleaks" as pr_secrets
  artifact "SAST / SCA\nSonar Quality Gate" as pr_sast
  artifact "Terraform\nfmt · validate · test" as pr_tf
}

package "Main-branch promotion" as main_promotion {
  rectangle "Build immutable image\ncommit SHA + digest" as main_image
  rectangle "Build + publish ml-service image\ncommit SHA + digest" as main_mlservice_image
  rectangle "Redeploy ml-service sidecar\nmanual dispatch + existing SHA" as main_mlservice_redeploy
  rectangle "Sync static web\nS3 + CloudFront invalidate" as main_web
  rectangle "Deploy backend or sidecar\nECS service update\n(shared task revision)" as main_backend
  rectangle "Apply infrastructure\nreviewed plan + confirmation" as main_tf
}

package "Evidence and response" as evidence {
  artifact "Job summaries\nstatus · commit · digest" as summaries
  artifact "Plan bundle\nmetadata · lockfile · run ID" as plan_evidence
  artifact "Security summary\nfindings · gate state" as security_evidence
  database "CloudWatch\napplication + database logs" as cw
  database "Security Hub\nInspector + Sonar findings" as sh
}

pr_backend --> main_image
pr_mlservice --> main_mlservice_image
pr_web --> main_web
pr_backend --> main_backend
pr_tf --> main_tf
pr_secrets --> security_evidence
pr_sast --> security_evidence
pr_tf --> plan_evidence
main_image --> summaries
main_mlservice_image --> summaries
main_mlservice_redeploy --> main_backend
main_mlservice_redeploy --> summaries
main_web --> summaries
main_backend --> summaries
main_tf --> plan_evidence
main_backend --> cw
main_tf --> summaries
security_evidence --> sh

note right of pr_tf
  Terraform is never run from a workstation.
  Validation is separate from plan and apply.
end note

note right of main_tf
  Apply checks account, commit, component,
  plan metadata and typed confirmation.
end note

note right of main_backend
  Backend push publication and the
  main-only existing-image redeploy
  both use the backend deploy role.
  The ml-service path is explicit and
  uses its separate deploy role.
end note

note right of main_mlservice_redeploy
  ML-service CI publishes on main,
  but does not roll the sidecar out
  automatically. Redeploy resolves an
  existing main-ancestor image digest and
  updates the shared ECS service with the
  dedicated ml-service deploy role.
end note

note bottom of security_evidence
  Import to Security Hub is main-only,
  controlled, redacted and non-remediating.
end note

legend right
  |= Style |= Meaning |
  --> | Gate, promotion or evidence flow |
  |<#ECEFF1>| CI stage |
  |<#F3E5F5>| Security / evidence |
  |<#FFF3E0>| Artifact / observability |
endlegend

