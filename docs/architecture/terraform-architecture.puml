@startuml terraform-architecture

' This source is intentionally split into focused pages. Keeping delivery,
' runtime services, and Terraform contracts separate prevents long labels from
' crossing unrelated edges when PlantUML lays out the graph.

title CrewSafe SG — Request and Data Path

left to right direction
skinparam dpi 160
skinparam defaultFontName Arial
skinparam defaultFontSize 18
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam wrapWidth 155
skinparam maxMessageSize 130
skinparam nodesep 55
skinparam ranksep 85
skinparam ArrowColor #455A64

skinparam rectangle {
  BackgroundColor #E8F5E9
  BorderColor #2E7D32
  FontColor #1B5E20
  FontSize 18
}
skinparam cloud {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
  FontColor #0D47A1
  FontSize 18
}
skinparam database {
  BackgroundColor #FFF3E0
  BorderColor #EF6C00
  FontColor #E65100
  FontSize 18
}

actor "Browser" as browser
actor "Mobile / CLI" as client
cloud "Cognito\nOAuth clients" as cognito

package "Web edge" as web_edge {
  cloud "CloudFront web\nHTTPS" as web_cf
  database "S3 web bucket\nprivate · OAC" as web_bucket
}

package "API edge" as api_edge {
  cloud "CloudFront API\nHTTPS" as api_cf
  rectangle "Public ALB\nCloudFront prefix-list only" as alb
}

package "VPC · 2 AZ" as vpc {
  package "Backend ECS task · one ENI" as backend_task {
    rectangle "ECS Fargate: backend\nprivate · no public IP" as ecs
    rectangle "ml-service sidecar\nlocalhost:8000 only\nessential · task-coupled" as mlservice
  }
  database "RDS PostgreSQL\nprivate · TLS" as rds
  rectangle "NAT gateway\nsingle AZ" as nat
}

cloud "NEA weather API" as weather
cloud "Bedrock\nClaude models" as bedrock

browser --> cognito
client --> cognito
browser --> web_cf
web_cf --> web_bucket
browser --> api_cf
client --> api_cf
api_cf --> alb
alb --> ecs
ecs --> rds
ecs --> nat
ecs --> mlservice
nat --> weather
mlservice --> nat
nat --> bedrock

note right of api_cf
  Viewer HTTPS.
  Origin HTTP.
  ALB hostname has no project cert.
end note

note bottom of ecs
  Authz server-side.
  No public IP.
end note

note bottom of mlservice
  No ALB, service discovery,
  or security-group ingress.
  Reaches Bedrock via the task
  role's own InvokeModel grant.
end note

note right of rds
  Ingress: app SG → TCP 5432.
  No egress rule.
end note

legend right
  |= Color |= Meaning |
  |<#E3F2FD>| Public edge / identity |
  |<#E8F5E9>| Network and compute |
  |<#FFF3E0>| Data and configuration |
  --> | Request or runtime flow |
endlegend

newpage

title CrewSafe SG — Platform Controls

left to right direction
skinparam dpi 160
skinparam defaultFontName Arial
skinparam defaultFontSize 18
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam wrapWidth 155
skinparam maxMessageSize 130
skinparam nodesep 55
skinparam ranksep 85
skinparam ArrowColor #455A64

skinparam rectangle {
  BackgroundColor #E8F5E9
  BorderColor #2E7D32
  FontColor #1B5E20
  FontSize 18
}
skinparam cloud {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
  FontColor #0D47A1
  FontSize 18
}
skinparam database {
  BackgroundColor #FFF3E0
  BorderColor #EF6C00
  FontColor #E65100
  FontSize 18
}
skinparam artifact {
  BackgroundColor #F3E5F5
  BorderColor #7B1FA2
  FontColor #4A148C
  FontSize 18
}

artifact "GitHub Actions\nCI + release" as github
cloud "SonarCloud" as sonar
cloud "Bedrock\nClaude models" as bedrock

package "Backend dependencies" as runtime {
  rectangle "ECS task\nbackend + ml-service sidecar" as ecs_platform
  database "ECR\nbackend + web + ml-service\nimmutable · scan on push" as ecr
  database "SSM\nruntime config" as ssm
  database "Secrets Manager\nweather + RDS creds\n+ Bedrock InvokeModel grant" as secrets
  artifact "CloudWatch\napp + DB + ml-service logs" as logs
}

package "Security" as security {
  artifact "OIDC importer\nBatchImport only" as importer
  artifact "Security Hub\nInspector + Sonar" as securityhub
}

github --> ecr
github --> ecs_platform
github --> importer
sonar --> importer
ecr --> securityhub
importer --> securityhub
ecs_platform --> ecr
ecs_platform --> ssm
ecs_platform --> secrets
ecs_platform --> logs
ecs_platform --> bedrock

note right of ecs_platform
  ECS roles separate.
  Release workflow owns revision.
  ml-service sidecar: essential,
  task-coupled, localhost-only.
end note

note right of importer
  No remediation / tickets.
end note

legend right
  |= Color |= Meaning |
  |<#E8F5E9>| Runtime |
  |<#FFF3E0>| Data and configuration |
  |<#F3E5F5>| Operations and delivery control |
  --> | Delivery or control flow |
endlegend

newpage

title CrewSafe SG — Terraform Component Contracts

left to right direction
skinparam dpi 160
skinparam defaultFontName Arial
skinparam defaultFontSize 17
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam wrapWidth 180
skinparam maxMessageSize 150
skinparam nodesep 45
skinparam ranksep 70
skinparam ArrowColor #455A64

skinparam rectangle {
  BackgroundColor #ECEFF1
  BorderColor #455A64
  FontColor #263238
  FontSize 17
}
skinparam artifact {
  BackgroundColor #F3E5F5
  BorderColor #7B1FA2
  FontColor #4A148C
  FontSize 17
}

artifact "GitHub Actions\nOIDC · reviewed CI" as ci
artifact "Versioned S3 state\naccount-isolated" as tf_state

package "Terraform roots" as roots {
  rectangle "Cognito\ncognito/shared-dev.tfstate" as tf_cognito
  rectangle "Network\nnetwork/shared-dev.tfstate" as tf_network
  rectangle "Secrets\nsecrets/shared-dev.tfstate" as tf_secrets
  rectangle "Database\ndatabase/shared-dev.tfstate" as tf_database
  rectangle "ECR\necr/shared-dev.tfstate" as tf_ecr
  rectangle "Compute\ncompute/shared-dev.tfstate" as tf_compute
  rectangle "IAM policy mgmt\niam-policy-management/shared-dev.tfstate" as tf_iam
  rectangle "SecurityHub import\nsecurityhub-import/shared-dev.tfstate" as tf_importer
}

rectangle "State backend\nbootstrap/terraform.tfstate\nself-bootstrap" as state_backend

' Contract edges carry no labels here; the exact contracts are listed in the
' architecture Markdown and the output contract files. This keeps the rendered
' page readable while preserving dependency direction.
tf_cognito ..> tf_secrets
tf_network ..> tf_secrets
tf_network ..> tf_database
tf_network ..> tf_compute
tf_secrets ..> tf_database
tf_secrets ..> tf_compute
tf_database ..> tf_compute
tf_ecr ..> tf_compute

ci --> state_backend
ci --> tf_cognito
ci --> tf_network
ci --> tf_secrets
ci --> tf_database
ci --> tf_ecr
ci --> tf_compute
ci --> tf_iam
ci --> tf_importer
state_backend ..> tf_state

note right of tf_state
  One key per root.
  Bootstrap creates the bucket;
  other roots use remote state.
end note

note bottom of tf_iam
  Managed CI policy bindings.
  No runtime dependency.
end note

note bottom of tf_importer
  OIDC role for Sonar → Security Hub.
  No remote-state input.
end note

legend right
  |= Style |= Meaning |
  --> | CI control flow |
  ..> | Remote-state dependency or state location |
endlegend

@enduml
