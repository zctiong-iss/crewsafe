.DS_Store
~$*
/AGENTS.md
/CLAUDE.md

# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks

# Java / Maven
target/
!.mvn/wrapper/maven-wrapper.jar
build/
*.class

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Node
node_modules/
dist/
.expo/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*

# Spec Kit configuration and locally installed agent skills
.specify/
.agents/skills/speckit-*/
.claude/skills/speckit-*/
/specs/

# Terraform local and generated files
.terraform/
**/.terraform/*
.terraform-data/
**/.backend/*
!**/.backend/*.tfbackend.example
**/backend.generated.tf
plan-bundle/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
*.tfvars.json
!*.tfvars.example
crash.log
crash.*.log

# Keep dependency selections reproducible
!.terraform.lock.hcl

# ML artifacts and data
*.ipynb_checkpoints/
*.pkl
*.joblib
*.parquet

# IDE
.idea/
.vscode/
*.iml

# Local orchestration run — logs from ./run.sh
.local-run/
.crewsafe-runtime/

# CI-generated active ignorefile (SCRUM-269) — filter-trivyignore.sh's
# runtime-only output, never the reviewed source file
# (.github/security/backend-image.trivyignore.source and
# .github/security/ml-service-image.trivyignore.source)
.trivyignore-active-*

# Scratch state for local/seed-cognito-local.sh — the emulator rewrites its own config
# and persists pools here, so it must never be the checked-in fixture.
local/.cognito-local/
backend/test-results.log
