# Copy to .env.local and fill in. .env.local is gitignored.
#
#   cp .env.example .env.local
#
# Get the values from Terraform:
#
#   cd ../infra/aws/cognito-staging && terraform output -raw backend_env
#
# None of these are secrets — the client id and pool id travel in the address bar on every
# login. They live here because they differ per environment, not because they are sensitive.

# The user pool's issuer. oidc-client-ts reads its discovery document to find the Hosted UI.
VITE_COGNITO_AUTHORITY=https://cognito-idp.ap-southeast-1.amazonaws.com/ap-southeast-1_XXXXXXXXX

# The *web* app client. Not the mobile one.
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Must match a callback URL registered on that client, exactly. Cognito rejects anything
# else, and the dev server is pinned to 5173 for this reason.
VITE_REDIRECT_URI=http://localhost:5173/callback
VITE_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/

# The backend. Run it with the same pool's settings, or it will reject the tokens this app
# obtains — see backend/src/main/resources/application.yml.
VITE_API_BASE_URL=http://localhost:8080
